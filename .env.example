# Ethereum Mainnet JSON-RPC endpoint used by Hardhat to fork mainnet state.
# Must be archive-capable. Any provider works (Alchemy, Infura, QuickNode, ...).
# Copy this file to .env and fill in your key:  cp .env.example .env
ETH_RPC_URL="https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY"

# --- Client-visible (inlined at build time; safe, no secrets) -----------------
# Lets the Transaction Terminal label the network. Set BOTH when deploying
# against a live mainnet RPC so the terminal shows "Ethereum Mainnet" instead
# of "Mainnet Fork / Hardhat Local". Leave unset for local `next dev`.
#   NEXT_PUBLIC_VERCEL_ENV   -> set to "$VERCEL_ENV" in Vercel project env
#   NEXT_PUBLIC_ETH_RPC_URL  -> the same provider URL as ETH_RPC_URL (host only
#                               is matched: infura / alchemy / quicknode / ...)
# NEXT_PUBLIC_VERCEL_ENV="production"
# NEXT_PUBLIC_ETH_RPC_URL="https://eth-mainnet.g.alchemy.com/v2/YOUR_API_KEY"

# Privy app id (https://dashboard.privy.io) — enables Telegram/social login
# with an auto-created EVM embedded wallet, and real transaction signing from
# the Transaction Terminal. Leave unset to keep the offline demo-wallet
# preview (no embedded wallet, no broadcast button, no error thrown).
# NEXT_PUBLIC_PRIVY_APP_ID="your-privy-app-id"
